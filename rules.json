{
  "rules": {
    "books": {
      ".read": "auth != null",
      ".write": "root.child('admin/admins').hasChild(auth.uid)"
    },
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "interactions": {
      "likes": {
        "$bookId": {
          ".read": "auth != null",
          "$uid": {
            ".write": "$uid === auth.uid"
          }
        }
      },
      "dislikes": {
        "$bookId": {
          ".read": "auth != null",
          "$uid": {
            ".write": "$uid === auth.uid"
          }
        }
      },
      "ratings": {
        "$bookId": {
          ".read": "auth != null",
          "$uid": {
            ".write": "$uid === auth.uid"
          }
        }
      },
      "comments": {
        "$bookId": {
          ".read": "auth != null",
          "$childId": {
            ".write": "auth != null && (!data.exists() ? newData.child('uid').val() === auth.uid : data.child('uid').val() === auth.uid)"
          }
        }
      }
    },
    "admin": {
      "admins": {
        "$uid": {
          ".read": "$uid === auth.uid",
          ".write": false
        }
      }
    }
  }
}